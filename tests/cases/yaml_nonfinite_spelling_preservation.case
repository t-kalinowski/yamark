-- args
format --stdin-file-path input.yaml --verify
-- stdin
positive:
  - .inf
  - .Inf
  - .INF
  - +.inf
  - +.Inf
  - +.INF
negative: [-.inf, -.Inf, -.INF]
nan: [.nan, .NaN, .NAN]
-- stdout
positive:
  - .inf
  - .Inf
  - .INF
  - +.inf
  - +.Inf
  - +.INF
negative: [-.inf, -.Inf, -.INF]
nan: [.nan, .NaN, .NAN]
-- stderr
-- status
0
