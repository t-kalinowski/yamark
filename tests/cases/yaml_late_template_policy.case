  Keep __strong__ and << literal  bytes >>.
plain: !markdown |
  Keep __strong__ and `literal  bytes`.
attached: !markdown
  |
    Keep __attached__.
ok: [x,y]
# fmt: template.delimiters "<<" ">>" scope=file
# fmt: markdown canonical=true scope=file
